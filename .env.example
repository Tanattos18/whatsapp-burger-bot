# =====================================================
# Configurações do Bot — Copie para .env e preencha
# =====================================================
# Como usar:
#   cp .env.example .env
#   Edite o arquivo .env com seus dados reais

# ─── LOJA ─────────────────────────────────────────
NOME_LOJA="Zé Delivery"
TELEFONE_SUPORTE="(11) 99999-9999"
TEMPO_ENTREGA_MIN=30
TEMPO_ENTREGA_MAX=45

# ─── HORÁRIO DE FUNCIONAMENTO ─────────────────────
# Formato: HH:MM (24h)
# Exemplo: 18:00 a 23:00
# Deixe vazio para funcionar 24h
HORARIO_INICIO=18:00
HORARIO_FIM=23:00

# ─── PAINEL WEB ───────────────────────────────────
PORT=3000
# Acesse em: http://localhost:3000

# ─── AUTENTICAÇÃO DO PAINEL ────────────────────────
# Usuário e senha para acesso ao painel administrativo
# Gere o hash com: node -e "const {getHashSenha}=require('./auth');console.log(getHashSenha('SUASENHA'))"
ADMIN_USER=admin
ADMIN_HASH=
# Salt opcional para maior segurança
ADMIN_SALT=

# ─── PIX — MODO DE PAGAMENTO ──────────────────
# Opções: estatico, mercadopago, asaas
# 
# PIX_MODO=estatico = Pix Copia e Cola (sem API)
# PIX_MODO=mercadopago = Mercado Pago (confirmação automática)
# PIX_MODO=asaas = Asaas (alternativa)

# ─── PIX ESTÁTICO ────────────────────────────────
PIX_MODO=estatico
PIX_CHAVE=
PIX_NOME="Zé Delivery"
PIX_CIDADE="Sao Paulo"

# ─── MERCADO PAGO ─────────────────────────────
# Como configurar:
#   1. Acesse https://www.mercadopago.com.br
#   2. Crie uma conta (pode ser pessoa física)
#   3. Vá em Configurações → APIs
#   4. Copie o Access Token
PIX_MODO=mercadopago
MERCADOPAGO_TOKEN=
MERCADOPAGO_AMBIENTE=sandbox

# ─── ASAAS (alternativa) ─────────────────────
# PIX_MODO=asaas
# ASAAS_API_KEY=
# ASAAS_AMBIENTE=sandbox

# ─── TELEGRAM (Notificações) ──────────────────
# Como configurar:
#   1. No Telegram, fala com @BotFather → /newbot
#   2. Copie o token:
TELEGRAM_TOKEN=
#   3. Adicione o bot ao grupo
#   4. Acesse: https://api.telegram.org/bot<TOKEN>/getUpdates
#   5. Copie o "id" do chat:
TELEGRAM_CHAT_ID=